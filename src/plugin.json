        "url": "https://github.com/SolaceLabs/solace-queuebrowser-datasource"
      },
      {
        "name": "Documentation",
        "url": "https://github.com/SolaceLabs/solace-queuebrowser-datasource#readme"
      },
      {
        "name": "Report an issue",
        "url": "https://github.com/SolaceLabs/solace-queuebrowser-datasource/issues"
      },
      {
        "name": "License",
        "url": "https://github.com/SolaceLabs/solace-queuebrowser-datasource/blob/main/LICENSE"
      }
    ],
